# yellow-matrix — kitty theme
# Paleta basada en "Golden Orange Diagonal Light Streaks":
# amarillo dorado #ffd500, ámbar #f5a300, naranja #e8720c, marrón profundo #7a3a00
# Fondo negro profundo semitransparente: el wallpaper (mvpaper) se ve
# a través de la terminal manteniendo el código legible.

cursor                 #ffd500
cursor_text_color      #0a0a0a

foreground             #ffe98f
background             #050505

# Transparencia: 0.75 deja ver el wallpaper sin sacrificar contraste
background_opacity     0.75

selection_foreground   #241a00
selection_background   #f5a300

url_color              #f5a300

color0   #050505
color1   #e04900
color2   #b8860b
color3   #ffd500
color4   #f5a300
color5   #e8720c
color6   #d99a1f
color7   #ffe98f

color8   #d0a93c
color9   #ff6a1f
color10  #e0b422
color11  #ffe135
color12  #ffc21f
color13  #ff8a2a
color14  #f0c04e
color15  #fff2ad

# Barra de pestañas (coherente con el tema)
tab_bar_margin_color      #050505
tab_bar_background        #050505

active_tab_foreground     #241a00
active_tab_background     #ffd500

inactive_tab_foreground   #c7a25e
inactive_tab_background   #050505

dim_opacity 0.6

# text_composition_strategy es lo recomendado; nada extra necesario
