# Font Configuration
# Restaurada el 2026-09-20: se perdio al reescribir kitty.conf con el tema matrix.
font_family JetBrainsMono Nerd Font
font_size 12.0

# MUCH CUSTOM WOW
cursor_trail 1
custom_shaders blaze
custom_shaders water
custom_shaders dim-inactive-windows
custom_shaders crt

# Window Configuration
window_padding_width 12
background_opacity 1.0
background_blur 32
hide_window_decorations yes

# Arreglo 2026-09-27: kitty abria maximizado SIEMPRE.
# Causa medida: `remember_window_size` (default yes) recuerda el tamaño *y* el
# estado maximizado de la ultima ventana en ~/.cache/kitty/main.json, y al
# arrancar lo vuelve a pedir con xdg_toplevel.set_maximized().
#   - main.json decia {"window-state": "maximized"}
#   - con WAYLAND_DEBUG=1 se veia `xdg_toplevel#46.set_maximized()` al inicio
#   - Hyprland lo obedecia y la ventana salia ocupando el monitor completo
# La opcion controla las dos cosas a la vez, no hay forma de recordar el tamaño
# sin recordar el maximizado (kitty/main.py: "Remember the maximized state from
# the previous session, if enabled"), asi que se desactiva. En Hyprland las
# ventanas en mosaico las dimensiona el compositor, no se pierde nada util.
remember_window_size no

# Cursor Configuration
cursor_shape block
cursor_blink_interval 1

# Scrollback
scrollback_lines 3000

# Terminal features
copy_on_select yes
strip_trailing_spaces smart

# Key bindings for common actions
map ctrl+shift+n new_window
map ctrl+t new_tab
map ctrl+plus change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0 change_font_size all 0

# Copiar al portapapeles TODA la salida del ultimo comando ejecutado.
# --type=clipboard no abre ninguna ventana: copia y ya. Requiere
# shell_integration (activada mas abajo en este mismo archivo).
# Restaurado el 2026-09-20: se perdio al reescribir kitty.conf con el tema matrix.
map ctrl+shift+a launch --type=clipboard --stdin-source=@last_cmd_output

# Tab configuration
tab_bar_style powerline
tab_bar_align left

# Shell integration
shell_integration enabled

# Color theme: yellow-matrix (paleta negro/amarillo/naranja)
# Nota: tras editar yellow-matrix.conf hay que tocar este archivo (con cambio
# de contenido) para que kitty lo recargue; su watcher no vigila los includes.
include dank-tabs.conf
include yellow-matrix.conf
