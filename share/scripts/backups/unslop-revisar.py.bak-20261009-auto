#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Comprobador de tics de IA en texto español.

Pasa la lista de patrones de la skill unslop_ESPAÑOL sobre ficheros y dice dónde
aparece cada uno. No reescribe nada: solo señala. La decisión es mía.

Uso:
    unslop-revisar.py FICHERO [FICHERO...]
    unslop-revisar.py --solo=rayas,dos-puntos FICHERO
    unslop-revisar.py --listar-reglas

Los ficheros de código se revisan solo en sus comentarios y cadenas de documentación,
nunca en el código ejecutable, para no proponer cambios que rompan el programa.
"""

import argparse
import re
import sys
from pathlib import Path

