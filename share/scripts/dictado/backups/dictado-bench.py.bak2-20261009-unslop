#!/usr/bin/env python3
"""dictado-bench — mide latencia y error (WER) de cada modelo de whisper en este equipo.

Compara modelos sobre un conjunto de pares `<nombre>.wav` + `<nombre>.txt` (el .txt es el
texto de referencia, lo que de verdad se dijo). Calcula:

  - tiempo de pared por muestra y factor de tiempo real (x veces más rápido que el audio)
  - WER: porcentaje de palabras mal (sustituciones + inserciones + omisiones / palabras reales)
  - pico de memoria residente del proceso (VmHWM leído de /proc durante la ejecución)
  - tamaño del fichero del modelo

Uso:
    dictado-bench.py [--dir CARPETA] [--modelos CARPETA_O_FICHERO ...]
                     [--json SALIDA.json] [--detalle] [--sin-vad]

Por defecto:
    --dir      /tmp/bench-es
    --modelos  ~/.local/share/whisper  y  ~/.local/share/whisper/candidatos

Los flags de whisper son EXACTAMENTE los que usa dictado.sh en producción, para que lo medido
sea lo que se va a vivir. Con --sin-vad se quita el VAD (útil para ver cuánto recorta).
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

BIN = os.path.expanduser("~/.local/bin/whisper-cli")
VAD = os.path.expanduser("~/.local/share/whisper/ggml-silero-v6.2.0.bin")
IDIOMA = "es"


# ---------------------------------------------------------------- texto

def normalizar(s):
    """Deja solo letras (con acentos), dígitos y espacios simples."""
    s = s.lower()
    s = re.sub(r"[^\w\s]", " ", s, flags=re.UNICODE)
    s = s.replace("_", " ")
    s = re.sub(r"\s+", " ", s).strip()
    # «47 320» y «47320» son lo mismo, así que se unen los dígitos separados por un espacio.
    s = re.sub(r"(?<=\d) (?=\d)", "", s)
    return s


def levenshtein(a, b):
    if not a:
        return len(b)
    if not b:
        return len(a)
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (ca != cb)))
        prev = cur
    return prev[-1]


def wer(referencia, hipotesis):
    """Devuelve (tasa, errores, palabras_de_referencia)."""
    r = normalizar(referencia).split()
    h = normalizar(hipotesis).split()
    if not r:
        return (0.0, 0, 0)
    d = levenshtein(r, h)
    return (d / len(r), d, len(r))


# ---------------------------------------------------------------- ejecución

def pico_memoria(pid, actual):
    """VmHWM de /proc/<pid>/status, en kB. Se queda con el mayor visto."""
    try:
        with open(f"/proc/{pid}/status") as f:
            for linea in f:
                if linea.startswith("VmHWM:"):
                    return max(actual, int(linea.split()[1]))
    except (OSError, ValueError, IndexError):
        pass
    return actual


def correr(modelo, wav, salida, con_vad, prompt=None):
    """Devuelve (segundos, texto, pico_kb, fallo).

    OJO con el cuarto valor. Antes esta función tiraba el stderr a /dev/null, y eso convertía un
    modelo que NO CARGA (fichero truncado, por ejemplo) en un modelo que «transcribe nada»: WER
    100 %, tiempo bajísimo, y encima el más rápido de la tabla. Un fallo de carga tiene que salir
    como fallo, no como resultado. Por eso ahora el stderr se guarda y se inspecciona.
    """
    args = [BIN, "-m", modelo, "-f", wav, "-l", IDIOMA, "-nt", "-np", "-otxt", "-of", salida]
    if con_vad and os.path.isfile(VAD):
        args += ["--vad", "-vm", VAD]
    if prompt:
        args += ["--prompt", prompt]
    errlog = salida + ".log"
    for ext in (".txt", ".log"):
        try:
            os.remove(salida + ext)
        except OSError:
            pass

    t0 = time.perf_counter()
    with open(errlog, "wb") as ferr:
        p = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=ferr)
        pico = 0
        while p.poll() is None:
            pico = pico_memoria(p.pid, pico)
            time.sleep(0.02)
    t1 = time.perf_counter()

    err = ""
    try:
        with open(errlog, errors="replace") as f:
            err = f.read()
    except OSError:
        pass

    fallo = None
    if "failed to initialize whisper context" in err:
        fallo = "no pudo cargar el modelo (¿fichero incompleto?)"
    elif p.returncode != 0:
        for linea in err.splitlines():
            if "error" in linea.lower():
                fallo = linea.strip()
                break
        if not fallo:
            fallo = f"código de salida {p.returncode}"
    elif not os.path.isfile(salida + ".txt"):
        fallo = "el proceso terminó bien pero no escribió salida"

    texto = ""
    try:
        with open(salida + ".txt") as f:
            texto = f.read().strip()
    except OSError:
        pass
    return t1 - t0, texto, pico, fallo


def correr_servidor(url, wav, tiempo_max=120):
    """Transcribe contra whisper-server. El modelo ya esta cargado, asi que no se paga su carga.

    Se mide el viaje completo (subir el WAV y recibir el JSON), que es lo que se vive de verdad.
    """
    t0 = time.perf_counter()
    resp = ""
    try:
        p = subprocess.run(
            ["curl", "-s", "--max-time", str(tiempo_max),
             "-F", f"file=@{wav}", "-F", f"language={IDIOMA}", "-F", "response_format=json",
             f"{url}/inference"],
            capture_output=True, text=True, check=False,
        )
        resp = p.stdout
    except Exception as e:
        return 0.0, "", 0, f"curl falló: {e}"
    t1 = time.perf_counter()
    texto = ""
    try:
        texto = json.loads(resp).get("text", "").strip()
    except Exception:
        return t1 - t0, "", 0, f"respuesta no es JSON: {resp[:80]!r}"
    return t1 - t0, texto, 0, None


def duracion(wav):
    out = subprocess.run(
        ["sox", "--i", wav], capture_output=True, text=True, check=False
    ).stdout
    m = re.search(r"Duration\s*:\s*(\d+):(\d+):([\d.]+)", out)
    if not m:
        return 0.0
    return int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))


def ajuste(filas):
    """Mínimos cuadrados de tiempo = coste_fijo + pendiente * segundos_de_audio.

    Esto separa dos cosas que se confunden todo el rato:
      - coste fijo: cargar el modelo en memoria. Se paga UNA vez por dictado, aunque digas
        una sola palabra. Es lo que más se nota en frases cortas.
      - pendiente: lo que cuesta cada segundo de audio (velocidad de cálculo).
    Un modelo grande puede tener mal coste fijo y buena pendiente; para dictado, donde las
    frases son de 3-10 s, el coste fijo manda.
    """
    n = len(filas)
    if n < 2:
        return None
    sx = sum(f["audio"] for f in filas)
    sy = sum(f["tiempo"] for f in filas)
    sxx = sum(f["audio"] ** 2 for f in filas)
    sxy = sum(f["audio"] * f["tiempo"] for f in filas)
    den = n * sxx - sx * sx
    if den == 0:
        return None
    b = (n * sxy - sx * sy) / den
    a = (sy - b * sx) / n
    return a, b


def resumir(filas, nombre, tam_mb, total_audio, servidor=False):
    """Agrega las pasadas de un modelo en una sola fila de resultado.

    De cada muestra se queda con la MEJOR pasada: la primera ejecución paga el arranque del
    proceso y no representa el coste de régimen.
    """
    por_muestra = {}
    for f in filas:
        k = f["muestra"]
        if k not in por_muestra or f["tiempo"] < por_muestra[k]["tiempo"]:
            por_muestra[k] = f
    elegidas = list(por_muestra.values())

    t_tot = sum(f["tiempo"] for f in elegidas)
    err_tot = sum(f["errores"] for f in elegidas)
    pal_tot = sum(f["palabras"] for f in elegidas)
    aj = ajuste(elegidas)
    motivos = [f.get("fallo") for f in elegidas if f.get("fallo")]
    # Si falla en TODAS las muestras no es un modelo peor: es un modelo que no se puede usar, y su
    # WER no significa nada. Se marca para que no contamine la tabla ni el veredicto.
    roto = bool(motivos) and len(motivos) == len(elegidas)
    return {
        "modelo": nombre,
        "mb": tam_mb,
        "servidor": servidor,
        "roto": roto,
        "fallos": len(motivos),
        "motivo": motivos[0] if motivos else None,
        "tiempo_total": t_tot,
        "audio_total": total_audio,
        "x_tiempo_real": total_audio / t_tot if t_tot else 0,
        "seg_por_10s": 10 * t_tot / total_audio if total_audio else 0,
        "wer": err_tot / pal_tot if pal_tot else 0,
        "errores": err_tot,
        "palabras": pal_tot,
        "pico_mb": max(f["pico_kb"] for f in elegidas) / 1024,
        "fijo_s": aj[0] if aj else None,
        "pendiente": aj[1] if aj else None,
        "detalle": elegidas,
    }


