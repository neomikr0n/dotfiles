def _color_wer(t):
    if t <= 0.10:
        return "#FFB300"
    if t <= 0.25:
        return "#FFC821"
    if t <= 0.50:
        return "#FF4E00"
    return "#FF3300"


def _nombre(n):
    """Nombre del modelo sin el envoltorio del fichero: ggml-large-v3-turbo.bin -> large-v3-turbo.

    Se usa para MOSTRAR. El nombre del fichero sigue siendo el que se pasa al binario.
    """
    if n.startswith("ggml-"):
        n = n[5:]
    if n.endswith(".bin"):
        n = n[:-4]
    return n


def _es_variante(r):
    """Fila que es el MISMO modelo con otra configuración (p. ej. sin VAD).

    Va en la tabla y en las barras —para poder comparar— pero no en los fallos ni en el veredicto:
    repetiría las mismas muestras y no es un modelo distinto que elegir.
    """
    return bool(r.get("variante"))


def _esc(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def _equipo():
    """Descripción corta de la máquina, leída de /proc (nada escrito a mano)."""
    cpu = "CPU desconocida"
    try:
        with open("/proc/cpuinfo") as f:
            for l in f:
                if l.startswith("model name"):
                    cpu = l.split(":", 1)[1].strip()
                    break
    except OSError:
        pass
    ram = ""
    try:
        with open("/proc/meminfo") as f:
            for l in f:
                if l.startswith("MemTotal:"):
                    ram = f"{int(l.split()[1]) / 1048576:.0f} GB"
                    break
    except (OSError, ValueError):
        pass
    return f"{cpu} · {ram}" if ram else cpu


def html_informe(resultados, meta):
    """Genera el informe completo. Todo lo que afirma sale de `resultados`."""
    orden = sorted(resultados, key=lambda r: (r["roto"], _es_variante(r), r["wer"]))
    usables = [r for r in orden if not r["roto"]]
    reales = [r for r in usables if not _es_variante(r)]
    rotos = [r for r in resultados if r["roto"]]
    if not usables:
        sys.exit("ningún modelo usable: todos fallaron al cargar")
    mejor_wer = reales[0]
    mejor_x = max(reales, key=lambda r: r["x_tiempo_real"])

    # --- chips
    chips = [
        ("#FFC821", len(reales), "MODELOS"),
        (_color_wer(mejor_wer["wer"]), f"{mejor_wer['wer']*100:.1f}%", "MEJOR WER"),
        ("#FF4E00", f"{mejor_x['x_tiempo_real']:.1f}x", "MÁS RÁPIDO"),
        ("#FFB300", f"{meta['audio']:.0f}s", "AUDIO"),
    ]
    if rotos:
        chips.append(("#FF3300", len(rotos), "NO CARGA"))
    html_chips = "".join(
        f'<div class="chip" style="--chip:{c}"><span class="chip-num">{n}</span>'
        f'<span class="chip-label">{l}</span></div>'
        for c, n, l in chips
    )

    # --- tabla principal
    filas = []
    for r in orden:
        mb = "—" if r["mb"] is None else f"{r['mb']:.0f}"
        marca = ('<span class="tag-srv">SERVIDOR</span>'
                 if r["servidor"] and "servidor" not in r["modelo"].lower() else "")
        if _es_variante(r):
            marca += '<span class="tag-var">VARIANTE</span>'
        if r["roto"]:
            filas.append(
                f'<tr class="roto"><td class="mono">{_esc(_nombre(r["modelo"]))}</td>'
                f'<td>{mb}</td><td>—</td><td>—</td>'
                f'<td><span class="badge" style="background:#FF3300;color:#0A0A0A">NO CARGA</span></td>'
                f'<td>—</td></tr>'
            )
            continue
        pico = "—" if r["servidor"] else f"{r['pico_mb']:.0f}"
        clase = ' class="srv"' if r["servidor"] else ""
        col = _color_wer(r["wer"])
        filas.append(
            f'<tr{clase}><td class="mono">{_esc(_nombre(r["modelo"]))}{marca}</td>'
            f'<td>{mb}</td><td>{r["seg_por_10s"]:.2f} s</td>'
            f'<td>{r["x_tiempo_real"]:.1f}×</td>'
            f'<td><span class="badge" style="background:{col};color:#0A0A0A">'
            f'{r["wer"]*100:.1f}%</span></td>'
            f'<td>{pico}</td></tr>'
        )
    tabla = (
        "<table><thead><tr><th>modelo</th><th>MB</th><th>por 10 s</th>"
        "<th>× tiempo real</th><th>WER</th><th>pico MB</th></tr></thead><tbody>"
        + "".join(filas) + "</tbody></table>"
    )

    # --- barras fijo vs marginal
    con_ajuste = [r for r in resultados if r["fijo_s"] is not None and not r["roto"]]
    barras = []
    if con_ajuste:
        escala = max(r["fijo_s"] + r["pendiente"] * 10 for r in con_ajuste) or 1
        for r in sorted(con_ajuste, key=lambda r: (r["mb"] is None, r["mb"] or 0)):
            fijo = r["fijo_s"]
            marg = r["pendiente"] * 10
            pf = 100 * fijo / escala
            pm = 100 * marg / escala
            barras.append(
                f'<div class="bar-row"><div class="bar-name">{_esc(_nombre(r["modelo"]))}</div>'
                f'<div class="bar-track"><div class="bar-fijo" style="width:{pf:.2f}%"></div>'
                f'<div class="bar-marg" style="width:{pm:.2f}%"></div></div>'
                f'<div class="bar-val">{fijo + marg:.2f} s</div></div>'
            )
    barras_html = ('<div class="bars">' + "".join(barras) + "</div>"
                   '<div class="leyenda">'
                   '<span><i style="background:#FF3300"></i>cargar el modelo (fijo, se paga en cada dictado)</span>'
                   '<span><i style="background:#FFB300"></i>10 s de audio (marginal)</span></div>')

    # --- dónde falla cada modelo
    fallos = []
    for r in orden:
        if r["roto"]:
            fallos.append(
                f'<div class="finding" style="--sev:#FF3300"><header>'
                f'<span class="sev-badge" style="background:#FF3300">NO CARGA</span>'
                f'<span class="line-badge">{_esc(_nombre(r["modelo"]))}</span></header>'
                f'<p>No llegó a transcribir nada: <strong>{_esc(r["motivo"] or "fallo desconocido")}</strong>. '
                f'Sus tiempos no se usan, porque medir un modelo que no arranca no mide nada. '
                f'Hay que volver a bajarlo y comprobar el tamaño contra el original.</p></div>'
            )
            continue
        if _es_variante(r):
            continue
        malas = sorted([f for f in r["detalle"] if f["wer"] > 0],
                       key=lambda f: -f["wer"])
        if not malas:
            fallos.append(
                f'<div class="finding" style="--sev:#FFB300"><header>'
                f'<span class="sev-badge" style="background:#FFB300">SIN FALLOS</span>'
                f'<span class="line-badge">{_esc(_nombre(r["modelo"]))}</span></header>'
                f'<p>Transcribió las {len(r["detalle"])} muestras sin un solo error de palabra.</p></div>'
            )
            continue
        peor = malas[0]
        sev = _color_wer(peor["wer"])
        etiqueta = "CRÍTICO" if peor["wer"] > 0.5 else ("GRAVE" if peor["wer"] > 0.25 else "MENOR")
        pares = []
        for f in malas[:6]:
            pares.append(
                f'<div class="code-pair">'
                f'<div class="code-wrap code-ref"><span class="code-label">SE DIJO</span>'
                f'<pre>{_esc(f["ref"])}</pre></div>'
                f'<div class="code-wrap code-obt"><span class="code-label">WER {f["wer"]*100:.0f}% · '
                f'{f["muestra"]}</span><pre>{_esc(f["texto"]) or "<nada>"}</pre></div></div>'
            )
        resto = ""
        if len(malas) > 6:
            resto = f'<p style="margin-top:12px">y {len(malas) - 6} muestra(s) más con error.</p>'
        fallos.append(
            f'<div class="finding" style="--sev:{sev}"><header>'
            f'<span class="sev-badge" style="background:{sev}">{etiqueta}</span>'
            f'<span class="line-badge">{_esc(_nombre(r["modelo"]))}</span>'
            f'<span class="line-badge">{len(malas)}/{len(r["detalle"])} muestras con error · '
            f'peor caso WER {peor["wer"]*100:.0f}%</span></header>'
            f'<p>WER global <strong style="color:{_color_wer(r["wer"])}">{r["wer"]*100:.1f}%</strong> '
            f'({r["errores"]} errores sobre {r["palabras"]} palabras).</p>'
            + "".join(pares) + resto + "</div>"
        )

    # --- veredicto. Son DOS decisiones distintas y no se pueden mezclar:
    #     (1) qué modelo, comparando binario contra binario
    #     (2) por qué vía, comparando el mismo modelo servido contra el binario
    limite = meta.get("limite_s", 3.0)
    cli = [(r, r["fijo_s"] + r["pendiente"] * 5) for r in resultados
           if not r["roto"] and not r["servidor"] and not _es_variante(r)
           and r["fijo_s"] is not None]
    srv = [(r, r["fijo_s"] + r["pendiente"] * 5) for r in resultados
           if not r["roto"] and r["servidor"] and r["fijo_s"] is not None]

    bloques = []
    if cli:
        aptos = [(r, e) for r, e in cli if e <= limite]
        mejor_cli, est_cli = min(cli, key=lambda p: p[0]["wer"])
        if aptos:
            elegido, est5 = min(aptos, key=lambda p: p[0]["wer"])
            if elegido is mejor_cli:
                bloques.append(
                    f'<strong>{_esc(_nombre(elegido["modelo"]))}</strong> gana en las dos columnas '
                    f'que importan: el mejor error de todos los binarios '
                    f'({elegido["wer"]*100:.1f}%) y una frase de 5 s resuelta en {est5:.2f} s. '
                    f'No hay nada que ceder.'
                )
            else:
                bloques.append(
                    f'Con un presupuesto de {limite:.0f} s por frase, el mejor modelo utilizable es '
                    f'<strong>{_esc(_nombre(elegido["modelo"]))}</strong> (error '
                    f'{elegido["wer"]*100:.1f}%, 5 s → {est5:.2f} s). '
                    f'<strong>{_esc(_nombre(mejor_cli["modelo"]))}</strong> baja el error a '
                    f'{mejor_cli["wer"]*100:.1f}% pero cuesta {est_cli:.2f} s, '
                    f'{est_cli - est5:.2f} s más por frase.'
                )
        else:
            bloques.append("Ningún modelo cabe en el presupuesto de latencia con estas muestras.")

    if srv:
        # se ordena por el coste de una frase de 5 s, que es la cifra comparable
        srv_ord = sorted(srv, key=lambda p: p[1])
        mejor_srv, est_srv = srv_ord[0]

        # Se busca el modelo del binario que corresponde al que sirve el servidor. Se elige la
        # coincidencia MÁS LARGA: si no, «large-v3» casaría con «large-v3-turbo (servidor)» y
        # compararía dos modelos distintos como si fueran el mismo.
        parejas = [(p, _nombre(os.path.basename(p[0]["modelo"]))) for p in cli]
        parejas = [(p, r) for p, r in parejas if r and r in mejor_srv["modelo"]]
        pareja = max(parejas, key=lambda pr: len(pr[1]))[0] if parejas else None
        if pareja:
            r_cli, est_cli5 = pareja
            bloques.append(
                f'Y hay una segunda palanca, independiente del modelo: '
                f'<strong>{_esc(_nombre(r_cli["modelo"]))}</strong> por binario resuelve una frase de 5 s en '
                f'{est_cli5:.2f} s, pero servido la resuelve en <strong>{est_srv:.2f} s</strong> '
                f'({est_cli5 / est_srv:.1f}× más rápido). El coste fijo cae de '
                f'{r_cli["fijo_s"]:.2f} s a {mejor_srv["fijo_s"]:.2f} s, porque el modelo ya está '
                f'cargado y no se paga su carga en cada dictado.'
            )
        else:
            bloques.append(
                f'Servido, la frase de 5 s se resuelve en <strong>{est_srv:.2f} s</strong>: '
                f'el modelo ya está cargado y su carga no se paga en cada dictado.'
            )

        # Con dos servidores medidos, el modelo SIGUE importando. Quitado el coste fijo, lo que
        # queda es la velocidad de cálculo, y ahí la diferencia se ve mejor, no peor.
        if len(srv_ord) >= 2:
            peor_srv, est_peor = srv_ord[-1]
            bloques.append(
                f'Y el servidor no vuelve irrelevante al modelo, al contrario. Con los dos '
                f'servidos, <strong>{_esc(_nombre(peor_srv["modelo"]))}</strong> tarda '
                f'{est_peor:.2f} s y <strong>{_esc(_nombre(mejor_srv["modelo"]))}</strong> '
                f'{est_srv:.2f} s ({est_peor / est_srv:.1f}× de diferencia). Sin el coste fijo lo '
                f'que queda es la velocidad de cálculo, y ahí la ventaja de turbo se ve más clara '
                f'que con el binario.'
            )
    texto_v = "</p><p>".join(bloques)

    con_mb = sorted((r["mb"], _nombre(r["modelo"])) for r in usables
                    if r["mb"] is not None and not _es_variante(r))
    coste_disco = ", ".join(f"{n} {m:.0f} MB" for m, n in con_mb) if con_mb else "—"

    return f"""<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Informe — comparación de modelos de dictado</title>
<style>{CSS}</style>
</head>
<body>
<header class="hero">
  <div class="hero-inner">
    <span class="kicker">Dictado · comparación medida</span>
    <h1>Qué modelo conviene en <span class="accent">esta máquina</span></h1>
    <div class="meta">
      {meta['fecha']} · <code>{_esc(meta['equipo'])}</code><br>
      {meta['muestras']} muestras de voz · {meta['audio']:.1f} s de audio · VAD
      {'activado' if meta['vad'] else 'desactivado'} · binario <code>{_esc(meta['binario'])}</code>
    </div>
    <div class="chips">{html_chips}</div>
  </div>
</header>

<main>
  <section>
    <h2><span class="dot" style="color:#FFC821;background:#FFC821"></span>Los números</h2>
    <div class="section-sub">Todo medido en esta máquina, un modelo por ejecución. Ordenado por error.</div>
    <div class="card-panel">{tabla}</div>
  </section>

  <section>
    <h2><span class="dot" style="color:#FF3300;background:#FF3300"></span>Por qué el modelo grande no es lo caro que parece</h2>
    <div class="section-sub">El tiempo de un dictado no es «lo grande que sea el modelo», es cuánto de ese tiempo se paga una vez.</div>
    <div class="card-panel">
      <p>Cargar el modelo en memoria es un coste <strong>fijo</strong>: se paga entero aunque dictes
      una sola palabra. El audio es un coste <strong>marginal</strong>: crece con los segundos que hablas.
      En dictado las frases son de 3 a 10 segundos, así que el fijo manda.</p>
      {barras_html}
    </div>
  </section>

  <section>
    <h2><span class="dot" style="color:#FF4E00;background:#FF4E00"></span>Dónde falla cada uno</h2>
    <div class="section-sub">Solo se listan las muestras con error. Lo que no aparece, lo clavó.</div>
    {"".join(fallos)}
  </section>

  <section>
    <h2><span class="dot" style="color:#FFC821;background:#FFC821"></span>Veredicto</h2>
    <div class="finding veredicto" style="--sev:#FFC821">
      <h3>Qué poner</h3>
      <p>{texto_v}</p>
    </div>
    <div class="card-panel" style="margin-top:18px">
      <p><strong>Cómo se cambia.</strong> El modelo en uso es un enlace simbólico, así que cambiar
      de modelo es un solo comando y no toca ninguna configuración:</p>
      <pre style="padding:14px 16px;background:#0D0E10;border-radius:10px;border:1px solid rgba(255,255,255,.06)">ln -sfn ~/.local/share/whisper/candidatos/ggml-large-v3-turbo.bin \\
        ~/.local/share/whisper/actual.bin
systemctl --user restart dictado-servidor</pre>
      <p style="margin-top:12px">Coste en disco de lo medido:
      {coste_disco}. Los ficheros de modelo no se cargan enteros en RAM: el pico residente medido
      está en la tabla.</p>
    </div>
  </section>

  <section>
    <h2><span class="dot" style="color:#9AA0A8;background:#9AA0A8"></span>Qué mide esto y qué no</h2>
    <div class="aviso">
      <strong>Sesgo conocido:</strong> si las muestras salen de un sintetizador de voz, son más
      fáciles que una voz real y las diferencias entre modelos aparecen <em>atenuadas</em>. Para que
      el número valga, hay que rehacerlo con voz propia.
      <ul>
        <li>El <strong>WER</strong> es la tasa de error de palabra: (sustituciones + inserciones +
        omisiones) / palabras dichas, por distancia de Levenshtein.</li>
        <li>El <strong>×tiempo real</strong> dice cuántas veces más rápido que el audio va el modelo.
        Un 8× transcribe 10 s de voz en 1.25 s.</li>
        <li>El <strong>pico de memoria</strong> es el máximo residente del proceso (VmHWM), no una estimación.</li>
        <li>La separación <strong>fijo / marginal</strong> sale de un ajuste por mínimos cuadrados
        sobre las muestras reales, no de una tabla del fabricante.</li>
      </ul>
    </div>
  </section>
</main>

<footer>Generado por <span class="mono">dictado-bench.py</span> · volver a correrlo basta para actualizar
este informe cuando cambies de modelo.</footer>
</body>
</html>
"""


# ---------------------------------------------------------------- principal

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dir", default=os.path.expanduser("~/.local/share/dictado/corpus"))
    ap.add_argument("--modelos", nargs="*", default=None)
    ap.add_argument("--json", default=None)
    ap.add_argument("--detalle", action="store_true")
    ap.add_argument("--sin-vad", action="store_true")
    ap.add_argument("--prompt", default=None,
                    help="prompt inicial de whisper: sesga el vocabulario hacia estas palabras")
    ap.add_argument("--repetir", type=int, default=1)
    ap.add_argument("--servidor", default=None,
                    help="URL de whisper-server, p. ej. http://127.0.0.1:8123")
    ap.add_argument("--etiqueta-servidor", default="(servidor)")
    ap.add_argument("--html", default=None, help="escribir el informe HTML en esta ruta")
    ap.add_argument("--desde-json", default=None,
                    help="regenerar las tablas y el informe desde un JSON ya medido, sin volver a medir")
    a = ap.parse_args()

    con_vad = not a.sin_vad

    # Volver a medir cuesta minutos. Si ya hay un JSON, se reutiliza, así se puede retocar el
    # informe sin pagar otra vez la medición.
    if a.desde_json:
        with open(a.desde_json) as f:
            resultados = json.load(f)
        if not resultados:
            sys.exit(f"{a.desde_json} no tiene resultados")
        total_audio = resultados[0]["audio_total"]
        n_muestras = len(resultados[0]["detalle"])
        return emitir(resultados, total_audio, n_muestras, con_vad, a)

    muestras = []
    for wav in sorted(glob.glob(os.path.join(a.dir, "*.wav"))):
        ref_txt = wav[:-4] + ".txt"
        if not os.path.isfile(ref_txt):
            continue
        with open(ref_txt) as f:
            muestras.append((os.path.basename(wav)[:-4], wav, f.read().strip()))
    if not muestras:
        sys.exit(f"no hay pares .wav/.txt en {a.dir}")

    if a.modelos is None:
        fuentes = [
            os.path.expanduser("~/.local/share/whisper"),
            os.path.expanduser("~/.local/share/whisper/candidatos"),
        ]
    else:
        fuentes = a.modelos

    modelos = []
    for f in fuentes:
        if os.path.isdir(f):
            modelos += glob.glob(os.path.join(f, "ggml-*.bin"))
        elif os.path.isfile(f):
            modelos.append(f)
    modelos = sorted(set(m for m in modelos if "silero" not in m))
    if not modelos:
        sys.exit("no encontré ningún modelo ggml-*.bin")

    dur = {n: duracion(w) for n, w, _ in muestras}
    total_audio = sum(dur.values())
    dmin, dmax = min(dur.values()), max(dur.values())

    print(f"binario : {BIN}")
    print(f"muestras: {len(muestras)}  ({total_audio:.1f} s de audio, {dmin:.1f} s a {dmax:.1f} s)")
    print(f"VAD     : {'sí' if con_vad else 'no'}   repeticiones: {a.repetir}")
    if dmin > 0 and dmax / dmin < 3:
        print("  AVISO: las muestras duran casi lo mismo. El ajuste fijo/marginal no se puede")
        print("         separar con este rango y dará números sin sentido. Ver dictado-corpus.sh.")
    print()

    resultados = []
    for modelo in modelos:
        nombre = os.path.basename(modelo)
        tam = os.path.getsize(modelo) / 1048576
        filas = []
        for rep in range(a.repetir):
            for n, wav, ref in muestras:
                t, texto, pico, fallo = correr(modelo, wav, "/tmp/bench-out", con_vad, a.prompt)
                tasa, err, nref = wer(ref, texto)
                filas.append(
                    {"muestra": n, "rep": rep, "tiempo": t, "audio": dur[n],
                     "wer": tasa, "errores": err, "palabras": nref,
                     "pico_kb": pico, "texto": texto, "ref": ref, "fallo": fallo}
                )
        # Se queda con la mejor pasada de cada muestra (la primera ejecución paga el arranque)
        etiqueta = nombre + (" (con prompt)" if a.prompt else "")
        resultados.append(resumir(filas, etiqueta, tam, total_audio))

    # ---- servidor (opcional): el modelo ya está cargado, así que no se paga su carga
    if a.servidor:
        filas = []
        for rep in range(a.repetir):
            for n, wav, ref in muestras:
                t, texto, _, fallo = correr_servidor(a.servidor, wav)
                tasa, err, nref = wer(ref, texto)
                filas.append(
                    {"muestra": n, "rep": rep, "tiempo": t, "audio": dur[n],
                     "wer": tasa, "errores": err, "palabras": nref,
                     "pico_kb": 0, "texto": texto, "ref": ref, "fallo": fallo}
                )
        resultados.append(
            resumir(filas, a.etiqueta_servidor, None, total_audio, servidor=True)
        )

    return emitir(resultados, total_audio, len(muestras), con_vad, a)


def emitir(resultados, total_audio, n_muestras, con_vad, a):
    """Imprime las tablas y escribe los ficheros de salida. No mide nada."""
    # ---- tabla
    print(f"{'modelo':<28}{'MB':>7}{'10 s':>8}{'x real':>8}{'WER':>8}{'pico MB':>9}")
    print("-" * 68)
    for r in sorted(resultados, key=lambda r: (r["roto"], r["wer"])):
        mb = "—" if r["mb"] is None else f"{r['mb']:.0f}"
        if r["roto"]:
            print(f"{r['modelo']:<28}{mb:>7}{'—':>8}{'—':>8}{'ROTO':>8}{'—':>9}")
            continue
        pico = "—" if r["servidor"] else f"{r['pico_mb']:.0f}"
        print(f"{r['modelo']:<28}{mb:>7}{r['seg_por_10s']:>7.2f}s"
              f"{r['x_tiempo_real']:>7.1f}x{r['wer']*100:>7.1f}%{pico:>9}")

    rotos = [r for r in resultados if r["roto"]]
    if rotos:
        print()
        for r in rotos:
            print(f"!! {r['modelo']}: NO SIRVE — {r['motivo']}")
        print("   Un modelo que no carga no tiene WER ni velocidad: sus cifras no se usan.")

    print()
    print("Desglose del tiempo (ajuste por mínimos cuadrados sobre las muestras):")
    print(f"{'modelo':<28}{'fijo':>9}{'por s de audio':>17}{'estimado 5 s':>14}")
    print("-" * 68)
    for r in sorted(resultados, key=lambda r: (r["mb"] is None, r["mb"] or 0)):
        if r["fijo_s"] is None or r["roto"]:
            continue
        est = r["fijo_s"] + r["pendiente"] * 5
        print(f"{r['modelo']:<28}{r['fijo_s']:>8.2f}s{r['pendiente']:>16.3f}s"
              f"{est:>13.2f}s")

    if a.detalle:
        print()
        for r in sorted(resultados, key=lambda r: (r["roto"], r["wer"])):
            print(f"### {r['modelo']}")
            if r["roto"]:
                print(f"  no transcribió nada: {r['motivo']}")
                print()
                continue
            for f in sorted(r["detalle"], key=lambda f: -f["wer"]):
                if f["wer"] == 0:
                    continue
                print(f"  [{f['muestra']}] WER {f['wer']*100:.0f}%  ({f['errores']}/{f['palabras']})")
                print(f"    ref: {f['ref']}")
                print(f"    obt: {f['texto'] or '<nada>'}")
            print()

    if a.json:
        with open(a.json, "w") as f:
            json.dump(resultados, f, ensure_ascii=False, indent=1)
        print(f"json -> {a.json}")

    if a.html:
        meta = {
            "fecha": time.strftime("%d/%m/%Y %H:%M"),
            "equipo": _equipo(),
            "muestras": n_muestras,
            "audio": total_audio,
            "vad": con_vad,
            "binario": os.path.basename(BIN),
        }
        with open(a.html, "w") as f:
            f.write(html_informe(resultados, meta))
        print(f"html -> {a.html}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
